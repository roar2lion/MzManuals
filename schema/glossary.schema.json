{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glossary.schema.json",
  "title": "Glossary",
  "description": "Terms shared by every manual. Referenced from text as [[term-id]].",
  "type": "object",
  "required": ["terms"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "term", "definition"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "term": {"type": "string"},
          "expansion": {"type": "string", "description": "What an abbreviation stands for."},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "definition": {"oneOf": [{"type": "string"}, {"type": "array", "minItems": 1, "items": {"type": "string"}}]},
          "applies_to": {"type": "array", "uniqueItems": true, "items": {"enum": ["PLEXOS", "PyPSA"]}},
          "see_also": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
